<!DOCTYPE html>
<html lang="<%= currentLang %>">
  <%- include ('partials/head') %>
  <body>
    <%- include ('partials/header') %>
    
    <main class="main" id="main-content" hx-target="this" hx-swap="innerHTML">
      <div class="main__container">
        <div class="main__studio-info studio-info">
          <div class="studio-info__logo">
            <img src="/images/anatestudio_logo.png" alt="Anate Studio logo" class="studio-info__logo-img">
          </div>
          <p class="studio-info__description" id="studio-description" data-lang="welcome_text">
            <%= t.welcome_text %>
          </p>
        </div>
        

        <div class="category-tabs" role="tablist">
          <button
            type="button"
            class="category-tabs__button category-tabs__button--left category-tabs__button--active"
            data-category-tab="story-based-games"
          >
            <!-- іконка "книжка" — показується замість тексту на вузьких екранах -->
            <svg class="category-tabs__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 6.5C10.5 5 8.5 4.5 4 4.5v13c4.5 0 6.5.5 8 2 1.5-1.5 3.5-2 8-2v-13c-4.5 0-6.5.5-8 2Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
              <path d="M12 6.5v13" stroke="currentColor" stroke-width="1.6"/>
            </svg>
            <span class="category-tabs__label" data-lang="category_story_based_games"><%= t.category_story_based_games %></span>
          </button>
          <button
            type="button"
            class="category-tabs__button category-tabs__button--right"
            data-category-tab="experimental-games"
          >
            <!-- іконка "колба" -->
            <svg class="category-tabs__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M9 3h6M10 3v6.2L5.2 17A2 2 0 0 0 7 20h10a2 2 0 0 0 1.8-3L14 9.2V3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M7.5 14h9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
            <span class="category-tabs__label" data-lang="category_experimental_games"><%= t.category_experimental_games %></span>
          </button>
        </div>

        <div class="blue-line blue-line--top"></div>

        <!-- Назва активної категорії — видима лише на вузьких екранах,
             де в табах замість назв показані іконки -->
        <h2 class="games-category-title" data-lang="category_story_based_games"><%= t.category_story_based_games %></h2>

        <div class="main__games games">
          <% games.forEach(game => { %>
            <%- include('game-card', { 
              id: game.id,
              category: game.category, 
              image: game.image, 
              name: game.name, 
              langKey: game.langKey,
              translation: t[game.langKey + '_short'],
              steamLink: game.steamLink,
              xBoxLink: game.xBoxLink,
              nintendoLink: game.nintendoLink,
              itchLink: game.itchLink,
              googlePlayLink: game.googlePlayLink,
              currentLang: currentLang,
            }) %>
          <% }) %>
        </div>

        <div class="blue-line blue-line--bottom"></div>
      </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>

</html>