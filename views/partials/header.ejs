<header class="header">
  <div class="header__container">
    <!-- Кнопка hamburger -->
    <button class="header__burger" data-action="toggle-menu" aria-label="Відкрити меню">
      <span class="burger__line"></span>
      <span class="burger__line"></span>
      <span class="burger__line"></span>
    </button>
  </div>
</header>

<!-- Меню — окремо від header, на весь екран -->
<nav class="nav" data-state="closed">
  <div class="nav__container">

    <div class="nav__lang">
      <button onClick="changeLanguage('ua')" class="lang-btn">UA</button>
      <span>|</span>
      <button onClick="changeLanguage('en')" class="lang-btn">EN</button>
    </div>

    <ul class="nav__games">
      <% games.forEach(game => { %>
        <li class="nav__item">
          <a href="#" class="nav__link" data-nav-game="<%= game.id %>" data-nav-category="<%= game.category %>"><%= game.name %></a>
        </li>
      <% }) %>
    </ul>
  </div>
</nav>